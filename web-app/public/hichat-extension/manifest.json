{
  "manifest_version": 3,
  "name": "Hi-chat remote camera",
  "version": "1.3.0",
  "description": "Lets Google Meet use the camera and microphone of the laptop running Hi-chat's /mirror page, and shows that page what you present.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
