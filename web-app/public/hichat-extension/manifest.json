{
  "manifest_version": 3,
  "name": "Hi-chat remote camera",
  "version": "1.14.0",
  "description": "Lets Google Meet, Microsoft Teams, Zoom (in the browser) and Glider AI interviews (hire.glider.ai) use the camera and microphone of the laptop running Hi-chat's /mirror page, and shows that page what you present and hear.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://app.zoom.us/*",
        "https://*.zoom.us/wc/*",
        "https://*.glider.ai/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://app.zoom.us/*",
        "https://*.zoom.us/wc/*",
        "https://*.glider.ai/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
