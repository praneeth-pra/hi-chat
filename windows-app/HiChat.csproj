<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hi-chat for Windows. GitHub Actions publishes it as one Hi-chat.exe
       (see .github/workflows/windows-app.yml); nothing else to install.
       It runs on .NET Framework 4.8, which comes with Windows 10 (1903 and
       later) and 11, so the exe carries no runtime of its own: about 1 MB
       instead of the 72 MB a self-contained .NET 8 build was. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 64-bit, like the WebView2 loader packed into it -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Hi-chat</AssemblyName>
    <RootNamespace>HiChat</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Hi-chat</Product>
    <Company>hi-techie.dev</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Accessibility" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <!-- Lets the project build anywhere, the Mac and Linux included -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="AppIcon.ico" LogicalName="AppIcon.ico" />
    <!-- WebView2's DLLs go inside Hi-chat.exe, so it stays one file (see Packed) -->
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)/lib/net462/Microsoft.Web.WebView2.Core.dll" LogicalName="Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)/lib/net462/Microsoft.Web.WebView2.WinForms.dll" LogicalName="Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x64/native/WebView2Loader.dll" LogicalName="WebView2Loader.dll" />
  </ItemGroup>
  <!-- Hi-chat 1.0.53 and older (.NET 8) install an update only if it is
       over 1,000,000 bytes, and this exe is a little under that: a line of
       dashes brings it over, so they can update to it. -->
  <Target Name="UpdateFloor" BeforeTargets="PrepareForBuild">
    <WriteLinesToFile File="$(IntermediateOutputPath)update-floor.txt" Lines="$([System.String]::new('-', 160000))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)update-floor.txt" LogicalName="update-floor.txt" />
    </ItemGroup>
  </Target>
</Project>
